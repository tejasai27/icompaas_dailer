# REQUIRED in production (when DJANGO_DEBUG is not true).
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# Defaults to false. Set to true only for local development.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
DJANGO_CORS_ALLOW_ALL_ORIGINS=true
PUBLIC_WEBHOOK_BASE_URL=
# Public entrypoint for the app (website + proxied API paths).
PUBLIC_HTTP_PORT=80

PGDATABASE=icompaas_dialer
PGUSER=icompaas_user
PGPASSWORD=icompaas_password
PGHOST=postgres
PGPORT=5432
# Optional direct host ports for local tooling/debug.
# Used only if you uncomment ports in docker-compose.yml.
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433

REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6380

TELEPHONY_PROVIDER=exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
EXOTEL_MAX_CALL_DURATION_SECONDS=0
EXOTEL_WAIT_URL=
EXOTEL_START_PLAYBACK_VALUE=
EXOTEL_START_PLAYBACK_TO=both

# Webhook signature secret. When set, incoming Exotel webhooks must include
# a valid HMAC-SHA256 signature in X-Exotel-Signature header, or a matching
# ?token= query parameter. Leave empty to accept all webhooks (NOT recommended for production).
EXOTEL_WEBHOOK_SECRET=

TRANSCRIPTION_BACKEND=local_whisper
TRANSCRIPTION_ENGLISH_ONLY=1
WHISPER_MODEL=small
WHISPER_LANGUAGE=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=1
WHISPER_CONDITION_ON_PREVIOUS_TEXT=0
WHISPER_TEMPERATURE=0

# Optional: only needed if TRANSCRIPTION_BACKEND=openai
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_LANGUAGE=
OPENAI_WHISPER_TIMEOUT_SECONDS=1800
RECORDING_UPLOAD_MAX_BYTES=52428800
AUTO_TRANSCRIBE_RECORDINGS=1
AUTO_TRANSCRIBE_LOCK_SECONDS=900
AUTO_TRANSCRIBE_RETRY_FAILED_SECONDS=180
AUTO_TRANSCRIBE_STALE_PROCESSING_SECONDS=1200
AUTO_TRANSCRIBE_DOWNLOAD_RETRIES=4
AUTO_TRANSCRIBE_DOWNLOAD_RETRY_DELAY_SECONDS=15
TRANSCRIPTION_PROGRESS_TTL_SECONDS=14400

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SOURCE_NUMBER=

HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ENABLED=0
HUBSPOT_TIMEOUT_SECONDS=12

# ── JWT Token Lifetimes (optional) ─────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
